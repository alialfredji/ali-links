---
import type { PrimaryLink } from '../config/profile';

interface Props {
  items: readonly PrimaryLink[];
}

const { items } = Astro.props;
---

<ul class="link-list">
  {
    items.map((item, index) => (
      <li>
        {item.href ? (
          <a
            class="primary-link"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            data-link={item.id}
            data-index={String(index + 1).padStart(2, '0')}
          >
            <span class="primary-link__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="primary-link__label">{item.label}</span>
          </a>
        ) : (
          <button
            type="button"
            class="primary-link"
            data-unavailable-action
            data-link={item.id}
            data-index={String(index + 1).padStart(2, '0')}
          >
            <span class="primary-link__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="primary-link__label">{item.label}</span>
          </button>
        )}
      </li>
    ))
  }
</ul>
