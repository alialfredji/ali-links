---
import type { PrimaryLink } from '../config/profile';

interface Props {
  items: readonly PrimaryLink[];
}

const { items } = Astro.props;
---

<ul class="link-list">
  {
    items.map((item, index) => (
      <li>
        <a
          class="primary-link"
          href={item.href}
          data-link={item.id}
          data-index={String(index + 1).padStart(2, '0')}
        >
          <span class="primary-link__index" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="primary-link__label">{item.label}</span>
          <span class="primary-link__action" aria-hidden="true">
            open
          </span>
        </a>
      </li>
    ))
  }
</ul>
