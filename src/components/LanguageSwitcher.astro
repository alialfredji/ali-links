---
import { siteConfig, type Locale } from '../config/site';
import { localePath } from '../lib/i18n';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
---

<nav class="language-switcher" aria-label={label}>
  <ul>
    {
      Object.entries(siteConfig.locales).map(([code, settings]) => (
        <li>
          <a
            href={localePath(code as Locale, '/', import.meta.env.BASE_URL)}
            hreflang={settings.languageTag}
            lang={settings.languageTag}
            aria-current={code === locale ? 'page' : undefined}
            data-locale={code}
          >
            {code.toUpperCase()}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>('[data-locale]')
    .forEach((link) => {
      link.addEventListener('click', () => {
        const locale = link.dataset.locale;
        if (locale) localStorage.setItem('brand-starter:locale', locale);
      });
    });
</script>

<style>
  ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    min-inline-size: 2.5rem;
    min-block-size: 2.5rem;
    place-items: center;
    border: 1px solid transparent;
    border-radius: var(--radius-round);
    color: var(--color-text-muted);
    font: var(--text-utility);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text);
  }

  a[aria-current='page'] {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--color-surface-raised);
  }
</style>
