---
import { profile } from '../config/profile';
import LinkList from './LinkList.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import SocialLinks from './SocialLinks.astro';
import StyleControls from './StyleControls.astro';

const currentYear = new Date().getFullYear();
const emphasis = 'build & operate better with AI';
const [introBefore = '', introAfter = ''] = (profile.bio[0] ?? '')
  .trim()
  .split(emphasis);
const remainingBio = profile.bio.slice(1).map((line) => line.trim());
---

<div class="profile-shell">
  <header class="profile-chrome" aria-label="Page controls">
    <span class="profile-path" aria-hidden="true">~/profile</span>
    <StyleControls />
  </header>

  <section class="profile-sheet" aria-label="Profile panel">
    <main id="main" class="profile-page">
      <header class="profile-header">
        <div class="profile-hero">
          <ResponsiveImage
            class="profile-portrait"
            {...profile.image}
            sizes="(max-width: 620px) 76px, 104px"
            widths={[76, 104, 152, 208, 304]}
            priority
          />
          <div class="profile-identity">
            <h1>{profile.name}</h1>
            <p class="profile-headline">{profile.headline}</p>
          </div>
        </div>

        <p class="profile-bio">
          {introBefore}<strong>{emphasis}</strong>{introAfter}{' '}
          {remainingBio.join(' ')}
        </p>

        <SocialLinks items={profile.socials} />
      </header>

      <nav class="primary-navigation" aria-label="Primary links">
        <LinkList items={profile.links} />
      </nav>

      <footer class="profile-footer">
        <span
          >© {currentYear} {profile.name} · Build & Operate better with AI</span
        >
      </footer>

      <dialog class="unavailable-dialog" data-unavailable-dialog>
        <div class="unavailable-dialog__content">
          <p class="unavailable-dialog__status" aria-hidden="true">
            status: not-ready
          </p>
          <h2 data-dialog-title>This isn’t ready yet.</h2>
          <p>
            I’m still putting the finishing touches on it. Please check back
            soon.
          </p>
          <button
            type="button"
            class="unavailable-dialog__close"
            data-dialog-close
          >
            Close
          </button>
        </div>
      </dialog>
    </main>
  </section>
</div>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    '[data-unavailable-dialog]',
  );
  const unavailableActions = document.querySelectorAll<HTMLButtonElement>(
    '[data-unavailable-action]',
  );
  const closeButton = dialog?.querySelector<HTMLButtonElement>(
    '[data-dialog-close]',
  );
  const dialogTitle = dialog?.querySelector<HTMLElement>('[data-dialog-title]');
  let lastTrigger: HTMLButtonElement | null = null;

  unavailableActions.forEach((button) => {
    button.addEventListener('click', () => {
      lastTrigger = button;
      const label = button.querySelector<HTMLElement>('.primary-link__label');
      if (dialogTitle && label) {
        dialogTitle.textContent = `${label.textContent} isn’t ready yet.`;
      }
      dialog?.showModal();
    });
  });

  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => lastTrigger?.focus());
</script>
