<div class="appearance-controls" aria-label="Appearance controls">
  <button
    type="button"
    class="theme-toggle"
    data-theme-toggle
    data-theme-current="dark"
    aria-label="Switch to light theme"
    aria-pressed="true"
    title="Switch to light theme"
  >
    <svg
      class="theme-toggle__icon theme-toggle__icon--sun"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="3.25"></circle>
      <path
        d="M12 2.75v2M12 19.25v2M2.75 12h2M19.25 12h2M5.46 5.46l1.42 1.42M17.12 17.12l1.42 1.42M18.54 5.46l-1.42 1.42M6.88 17.12l-1.42 1.42"
      ></path>
    </svg>
    <svg
      class="theme-toggle__icon theme-toggle__icon--moon"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M20.25 15.15A8.6 8.6 0 0 1 8.85 3.75a8.6 8.6 0 1 0 11.4 11.4Z"
      ></path>
    </svg>
    <span class="visually-hidden theme-toggle__label"
      >Switch to light theme</span
    >
  </button>
</div>

<script>
  import type { Theme } from '../lib/preferences';

  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]',
  );

  const store = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      // Preferences remain session-only when storage is unavailable.
    }
  };

  const applyTheme = (theme: Theme) => {
    root.dataset.theme = theme;
    if (!themeToggle) return;
    const isDark = theme === 'dark';
    themeToggle.setAttribute('aria-pressed', String(isDark));
    themeToggle.dataset.themeCurrent = theme;
    const action = isDark ? 'Switch to light theme' : 'Switch to dark theme';
    const label = themeToggle.querySelector<HTMLElement>(
      '.theme-toggle__label',
    );
    if (label) label.textContent = action;
    themeToggle.setAttribute('aria-label', action);
    themeToggle.setAttribute('title', action);
  };

  let savedTheme: Theme = 'dark';
  try {
    savedTheme =
      localStorage.getItem('ali-links:theme') === 'light' ? 'light' : 'dark';
  } catch {
    // Keep the dark default when storage is unavailable.
  }
  applyTheme(savedTheme);

  themeToggle?.addEventListener('click', () => {
    const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(theme);
    store('ali-links:theme', theme);
  });
</script>
