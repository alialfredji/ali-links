---
import { siteConfig, type Locale } from '../config/site';
import { localePath, withBase } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  noindex = false,
} = Astro.props;
const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(canonicalPath, site);
const siteRoot = new URL(withBase('/', import.meta.env.BASE_URL), site);
const organizationId = `${siteRoot.href}#organization`;
const websiteId = `${siteRoot.href}#website`;
const alternates = Object.entries(siteConfig.locales).map(
  ([code, settings]) => ({
    code,
    languageTag: settings.languageTag,
    href: new URL(
      localePath(code as Locale, '/', import.meta.env.BASE_URL),
      site,
    ),
  }),
);
const xDefault = new URL(withBase('/', import.meta.env.BASE_URL), site);
const socialImage = siteConfig.socialImage
  ? new URL(withBase(siteConfig.socialImage, import.meta.env.BASE_URL), site)
  : null;
const localeSettings = siteConfig.locales[locale];
const alternateOgLocales = Object.values(siteConfig.locales)
  .filter(
    (settings) => settings.openGraphLocale !== localeSettings.openGraphLocale,
  )
  .map((settings) => settings.openGraphLocale);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': siteConfig.organizationType,
      '@id': organizationId,
      name: siteConfig.name,
      url: siteRoot.href,
      email: siteConfig.email,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteRoot.href,
      name: siteConfig.name,
      publisher: { '@id': organizationId },
      inLanguage: Object.values(siteConfig.locales).map(
        (settings) => settings.languageTag,
      ),
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': organizationId },
      inLanguage: localeSettings.languageTag,
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'}
/>
<link rel="canonical" href={canonical} />
{
  alternates.map((alternate) => (
    <link
      rel="alternate"
      hreflang={alternate.languageTag}
      href={alternate.href}
    />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={localeSettings.openGraphLocale} />
{
  alternateOgLocales.map((ogLocale) => (
    <meta property="og:locale:alternate" content={ogLocale} />
  ))
}
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:alt" content={title} />}

<meta
  name="twitter:card"
  content={socialImage ? 'summary_large_image' : 'summary'}
/>
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>
