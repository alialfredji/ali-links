---
import { siteConfig } from '../config/site';

interface Props {
  href?: string;
}

const { href = import.meta.env.BASE_URL } = Astro.props;
---

<a class="brand-mark" {href} aria-label={siteConfig.name}>
  <span class="brand-mark__symbol" aria-hidden="true"><i></i><i></i></span>
  <span>{siteConfig.name}</span>
</a>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand-mark__symbol {
    position: relative;
    display: block;
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .brand-mark__symbol i {
    position: absolute;
    display: block;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: 1px solid currentColor;
  }

  .brand-mark__symbol i:first-child {
    inset: 0 auto auto 0;
  }

  .brand-mark__symbol i:last-child {
    inset: auto 0 0 auto;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
