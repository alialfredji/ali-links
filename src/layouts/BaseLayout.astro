---
import Analytics from '../components/Analytics.astro';
import SeoHead from '../components/SeoHead.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
}

const { title, description, canonicalPath, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.languageTag} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#090a0c" />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href={withBase('/favicon.ico', import.meta.env.BASE_URL)}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={withBase('/favicon-32.png', import.meta.env.BASE_URL)}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href={withBase('/favicon-96.png', import.meta.env.BASE_URL)}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href={withBase('/favicon-512.png', import.meta.env.BASE_URL)}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase('/apple-touch-icon.png', import.meta.env.BASE_URL)}
    />
    <link
      rel="sitemap"
      href={withBase('/sitemap-index.xml', import.meta.env.BASE_URL)}
    />
    <SeoHead {title} {description} {canonicalPath} {noindex} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
