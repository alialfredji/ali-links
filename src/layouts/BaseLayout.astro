---
import SeoHead from '../components/SeoHead.astro';
import { siteConfig, type Locale } from '../config/site';
import { withBase } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locales[locale].languageTag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f8fb" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase('/favicon.svg', import.meta.env.BASE_URL)}
    />
    <link
      rel="sitemap"
      href={withBase('/sitemap-index.xml', import.meta.env.BASE_URL)}
    />
    <SeoHead {locale} {title} {description} {canonicalPath} {noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
